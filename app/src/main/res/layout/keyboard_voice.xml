<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F6F4EE">
    <TextView
        android:id="@+id/keyboardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Српски глас — спреман"
        android:textColor="#52615B"
        android:textSize="15sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/switchKeyboardButton"
            android:layout_width="64dp"
            android:layout_height="58dp"
            android:text="⌨"
            android:textSize="22sp" />
        <Button
            android:id="@+id/keyboardMicButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🎙  Диктирај ћирилицом"
            android:textAllCaps="false"
            android:textSize="18sp" />
        <Button
            android:id="@+id/backspaceButton"
            android:layout_width="64dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:text="⌫"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
