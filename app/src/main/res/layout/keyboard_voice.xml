<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F6F4EE">
    <LinearLayout
        android:id="@+id/topControlRow"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/keyboardMicButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="3"
            android:minWidth="0dp"
            android:padding="0dp"
            android:backgroundTint="#19785B"
            android:text="🎙  Диктирај ћирилицом"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/scriptButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:backgroundTint="#1976D2"
            android:text="Ћир/Lat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <Button
        android:id="@+id/openKeyboardButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#FFF3B0"
        android:text="Отвори тастатуру"
        android:textAllCaps="false"
        android:textColor="#5A4600"
        android:textSize="16sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/keyboardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
    <LinearLayout
        android:id="@+id/letterRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
    <LinearLayout
        android:id="@+id/functionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">
            <Button android:id="@+id/switchKeyboardButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#E1E3E2" android:minWidth="0dp" android:padding="0dp" android:text="⇄" android:textColor="#333333" android:textSize="18sp" />
            <Button android:id="@+id/symbolsButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="123/#+=" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/shiftButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="⇧" android:textSize="20sp" />
            <Button android:id="@+id/backspaceButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="⌫" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">
            <Button android:id="@+id/commaButton" android:layout_width="52dp" android:layout_height="50dp" android:minWidth="0dp" android:padding="0dp" android:text="," android:textSize="18sp" />
            <Button android:id="@+id/spaceButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="РАЗМАК" android:textAllCaps="false" android:textSize="15sp" />
            <Button android:id="@+id/periodButton" android:layout_width="52dp" android:layout_height="50dp" android:minWidth="0dp" android:padding="0dp" android:text="." android:textSize="18sp" />
            <Button android:id="@+id/enterButton" android:layout_width="84dp" android:layout_height="50dp" android:minWidth="0dp" android:padding="0dp" android:includeFontPadding="false" android:text="↵" android:textAllCaps="false" android:textSize="48sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
        <Button
            android:id="@+id/hideKeyboardButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#FFF3B0"
            android:text="Сакриј тастатуру"
            android:textAllCaps="false"
            android:textColor="#5A4600"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
