<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F6F4EE">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Српски глас"
        android:textColor="#17221E"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Изговори текст на српском — добићеш ћирилицу."
        android:textColor="#52615B"
        android:textSize="16sp" />

    <Button
        android:id="@+id/dictateButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:text="🎙  Започни диктирање"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="#FFFFFF"
        android:gravity="top|start"
        android:hint="Овде ће се појавити ћирилични текст…"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="16dp"
        android:textColor="#17221E"
        android:textSize="19sp" />

    <Button
        android:id="@+id/copyButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Копирај текст"
        android:textAllCaps="false"
        android:textSize="17sp" />
</LinearLayout>
